{
  "name": "reearth-papers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "bash scripts/deploy.sh",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "dev:viewer": "wrangler dev --port 8787 --local-upstream localhost:8787"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.4",
    "@jsquash/webp": "^1.5.0",
    "@reearth/ezu": "^0.9.0",
    "@reearth/okibi": "^0.5.0",
    "geotiff": "^3.0.5",
    "pmtiles": "^4.4.1"
  },
  "devDependencies": {
    "protomaps-themes-base": "^4.5.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.93.0"
  }
}
